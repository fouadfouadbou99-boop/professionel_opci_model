import streamlit as st
import pandas as pd
import numpy as np
import numpy_financial as npf
import plotly.express as px
import io
import traceback

# =====================================================
# CONFIGURATION
# =====================================================

st.set_page_config(
    page_title="Modèle Financier Immobilier",
    layout="wide"
)

st.title("🏢 Modèle Financier Immobilier")
st.markdown("Analyse de rentabilité immobilière")

# =====================================================
# CHARGEMENT FICHIER
# =====================================================

uploaded_file = st.file_uploader(
    "📂 Charger votre fichier Excel",
    type=["xlsx"]
)

if uploaded_file is None:
    st.info("Veuillez charger votre fichier Excel.")
    st.stop()

try:

    excel_file = pd.ExcelFile(uploaded_file)

    if "Hypothèses" in excel_file.sheet_names:
        sheet_name = "Hypothèses"
    elif "Hypotheses" in excel_file.sheet_names:
        sheet_name = "Hypotheses"
    else:
        st.error(
            f"Feuille Hypothèses introuvable.\n\n"
            f"Feuilles disponibles : {excel_file.sheet_names}"
        )
        st.stop()

    hypotheses_df = pd.read_excel(
        excel_file,
        sheet_name=sheet_name
    )

    hypotheses_df.columns = [
        "Parameter",
        "Value"
    ]

    hypotheses_df = hypotheses_df.dropna()

    hypotheses_df = hypotheses_df.set_index(
        "Parameter"
    )

except Exception:

    st.error("Erreur lecture Excel")

    st.code(
        traceback.format_exc()
    )

    st.stop()

# =====================================================
# FONCTION
# =====================================================

def get_hypothesis(name):

    try:

        value = hypotheses_df.loc[
            name,
            "Value"
        ]

        return float(value)

    except Exception:

        st.error(
            f"Paramètre absent : {name}"
        )

        st.stop()

# =====================================================
# HYPOTHESES
# =====================================================

prix_acquisition = get_hypothesis(
    "Prix acquisition"
)

frais_acquisition = get_hypothesis(
    "Frais acquisition %"
)

travaux = get_hypothesis(
    "Travaux"
)

loyer_brut_an1 = get_hypothesis(
    "Loyer brut An1"
)

croissance_loyers = get_hypothesis(
    "Croissance loyers %"
)

vacance = get_hypothesis(
    "Vacance %"
)

charges = get_hypothesis(
    "Charges %"
)

dette_pct = get_hypothesis(
    "Dette %"
)

taux_dette = get_hypothesis(
    "Taux dette %"
)

duree_dette = int(
    get_hypothesis(
        "Duree dette"
    )
)

horizon = int(
    get_hypothesis(
        "Horizon"
    )
)

exit_cap_rate = get_hypothesis(
    "Exit Cap Rate %"
)

frais_cession = get_hypothesis(
    "Frais cession %"
)

taux_actualisation = get_hypothesis(
    "Taux actualisation %"
)

# =====================================================
# INVESTISSEMENT
# =====================================================

budget_total = (
    prix_acquisition *
    (1 + frais_acquisition)
    + travaux
)

montant_dette = (
    budget_total *
    dette_pct
)

equity = (
    budget_total -
    montant_dette
)

# =====================================================
# DETTE
# =====================================================

monthly_rate = taux_dette / 12

nper = duree_dette * 12

if monthly_rate > 0:

    mensualite = npf.pmt(
        monthly_rate,
        nper,
        -montant_dette
    )

else:

    mensualite = montant_dette / nper

solde = montant_dette

debt_rows = []

for annee in range(
    1,
    duree_dette + 1
):

    debut = solde

    interets = 0
    principal = 0

    for mois in range(12):

        if solde <= 0:
            break

        interet = (
            solde *
            monthly_rate
        )

        principal_mensuel = (
            mensualite -
            interet
        )

        principal_mensuel = min(
            principal_mensuel,
            solde
        )

        solde -= principal_mensuel

        interets += interet

        principal += principal_mensuel

    debt_rows.append([
        annee,
        debut,
        interets,
        principal,
        interets + principal,
        max(solde, 0)
    ])

debt_df = pd.DataFrame(
    debt_rows,
    columns=[
        "Année",
        "Solde Début",
        "Intérêts",
        "Principal",
        "Service Dette",
        "Solde Fin"
    ]
)

# =====================================================
# PROJECTIONS
# =====================================================

projection_rows = []

loyer = loyer_brut_an1

for annee in range(
    1,
    horizon + 1
):

    revenus_bruts = loyer

    vacance_montant = (
        revenus_bruts *
        vacance
    )

    revenus_nets = (
        revenus_bruts -
        vacance_montant
    )

    charges_montant = (
        revenus_nets *
        charges
    )

    noi = (
        revenus_nets -
        charges_montant
    )

    interets = 0
    principal = 0

    if annee <= duree_dette:

        ligne = debt_df[
            debt_df["Année"] == annee
        ]

        if not ligne.empty:

            interets = (
                ligne["Intérêts"]
                .iloc[0]
            )

            principal = (
                ligne["Principal"]
                .iloc[0]
            )

    cash_flow_equity = (
        noi -
        interets -
        principal
    )

    projection_rows.append([
        annee,
        revenus_bruts,
        revenus_nets,
        noi,
        interets,
        principal,
        cash_flow_equity
    ])

    loyer = (
        loyer *
        (
            1 +
            croissance_loyers
        )
    )

projection_df = pd.DataFrame(
    projection_rows,
    columns=[
        "Année",
        "Revenus Bruts",
        "Revenus Nets",
        "NOI",
        "Intérêts",
        "Principal",
        "Cash Flow Equity"
    ]
)

# =====================================================
# VALEUR TERMINALE
# =====================================================

noi_sortie = (
    projection_df["NOI"]
    .iloc[-1]
)

valeur_terminale = (
    noi_sortie /
    exit_cap_rate
)

produit_net_cession = (
    valeur_terminale *
    (
        1 -
        frais_cession
    )
)

# =====================================================
# KPI
# =====================================================

project_cf = [
    -budget_total
]

project_cf.extend(
    projection_df["NOI"].tolist()
)

project_cf[-1] += (
    produit_net_cession
)

equity_cf = [
    -equity
]

equity_cf.extend(
    projection_df[
        "Cash Flow Equity"
    ].tolist()
)

equity_cf[-1] += (
    produit_net_cession
)

tri_projet = npf.irr(project_cf)

tri_equity = npf.irr(equity_cf)

van = (
    npf.npv(
        taux_actualisation,
        project_cf[1:]
    )
    + project_cf[0]
)

moic = (
    sum(
        x
        for x in equity_cf
        if x > 0
    )
    /
    abs(equity_cf[0])
)

# =====================================================
# DASHBOARD
# =====================================================

st.header("📈 Indicateurs")

c1, c2, c3, c4 = st.columns(4)

c1.metric(
    "TRI Projet",
    f"{tri_projet:.2%}"
)

c2.metric(
    "TRI Equity",
    f"{tri_equity:.2%}"
)

c3.metric(
    "VAN",
    f"{van:,.0f}"
)

c4.metric(
    "MOIC",
    f"{moic:.2f}x"
)

st.header("Projection Financière")

st.dataframe(
    projection_df,
    use_container_width=True
)

st.header("Tableau de Dette")

st.dataframe(
    debt_df,
    use_container_width=True
)

# =====================================================
# GRAPHIQUES
# =====================================================

fig = px.line(
    projection_df,
    x="Année",
    y=[
        "NOI",
        "Cash Flow Equity"
    ],
    title="NOI et Cash Flow Equity"
)

st.plotly_chart(
    fig,
    use_container_width=True
)

# =====================================================
# EXPORT EXCEL
# =====================================================

buffer = io.BytesIO()

with pd.ExcelWriter(
    buffer,
    engine="xlsxwriter"
) as writer:

    projection_df.to_excel(
        writer,
        sheet_name="Projection",
        index=False
    )

    debt_df.to_excel(
        writer,
        sheet_name="Dette",
        index=False
    )

st.download_button(
    "📥 Télécharger Excel",
    buffer.getvalue(),
    "projection_immobiliere.xlsx",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
)
