183
# DETTE
184
# =====================================================
185
 
186
monthly_rate = taux_dette / 12
187
 
188
nper = duree_dette * 12
189
 
190
if monthly_rate > 0:
191
 
192
mensualite = npf.pmt(
193
monthly_rate,
194
nper,
195
-montant_dette
196
)
197
 
198
else:
199
 
200
mensualite = montant_dette / nper
201
 
202
solde = montant_dette
203
 
204
debt_rows = []
205
 
206
for annee in range(
207
1,
208
duree_dette + 1
209
):
210
 
211
debut = solde
212
 
213
interets = 0
214
principal = 0
215
 
216
for mois in range(12):
217
 
218
if solde <= 0:
219
break
220
 
221
interet = (
222
solde *
223
monthly_rate
224
)
225
 
226
principal_mensuel = (
227
mensualite -
228
interet
229
)
230
 
231
principal_mensuel = min(
232
principal_mensuel,
233
solde
234
)
235
 
236
solde -= principal_mensuel
237
 
238
interets += interet
239
 
240
principal += principal_mensuel
241
 
242
debt_rows.append([
243
annee,
244
debut,
245
interets,
246
principal,
247
interets + principal,
248
max(solde, 0)
249
])
